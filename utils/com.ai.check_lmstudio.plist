<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- 任意唯一名称 -->
    <key>Label</key>
    <string>com.ai.check_lmstudio</string>

    <!-- 执行的脚本 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- 包一层，给每行日志打上时间戳 -->
        <string>exec /Users/ai_diagnosis/projects/chifeng-ai-diagnosis/utils/check_lmstudio.sh 2&gt;&amp;1 | while IFS= read -r line; do printf "%s %s\n" "$(date +"%Y-%m-%d %H:%M:%S")" "$line"; done</string>
    </array>

    <!-- 立即运行一次，加载后不等待间隔 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 每 5 分钟执行一次 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- 显式设置 PATH，避免 launchd 环境找不到 lms -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/ai_diagnosis/.lmstudio/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- 日志输出路径 -->
    <key>StandardOutPath</key>
    <string>/Users/ai_diagnosis/projects/chifeng-ai-diagnosis/service_data/check_lmstudio_logs/out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ai_diagnosis/projects/chifeng-ai-diagnosis/service_data/check_lmstudio_logs/error.log</string>

</dict>
</plist>